{
  "manifest_version": 3,
  "name": "Beautiful Todo - New Tab",
  "version": "1.0.0",
  "description": "A beautiful and functional todo list for your new tab",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
